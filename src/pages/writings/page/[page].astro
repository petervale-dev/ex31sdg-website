---
import type { CollectionEntry } from 'astro:content';
import WritingsArchive from '../../../components/WritingsArchive.astro';
import { getWritings } from '../../../lib/writings';
export async function getStaticPaths() {
  const entries = await getWritings();
  const totalPages = Math.ceil(entries.length / 20);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { entries: entries.slice((i + 1) * 20, (i + 2) * 20), current: i + 2, totalPages },
  }));
}
interface Props { entries: CollectionEntry<'writings'>[]; current: number; totalPages: number; }
---
<WritingsArchive {...Astro.props} />
